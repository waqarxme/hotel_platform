# ====================================================================
# HOTEL BOOKING PLATFORM — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env.local and populate with your credentials.
# ====================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session JWT Secret (Minimum 16 characters)
JWT_SECRET=your_jwt_session_secret_key_at_least_16_chars

# Supabase URL & Public Anonymous Key (RLS Enforced - NEVER use Service Role Key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_public_anon_key

# Optional PostgreSQL Direct Database URL
DATABASE_URL=
